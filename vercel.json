{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mcp.go": {
      "maxDuration": 60
    },
    "api/messages/index.go": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/v1/messages",
      "destination": "/api/messages"
    }
  ],
  "redirects": [
    { "source": "/", "destination": "https://dm-dot.ashray.xyz/", "permanent": false },
    { "source": "/docs", "destination": "https://dm-dot.ashray.xyz/docs", "permanent": false },
    { "source": "/docs/:path*", "destination": "https://dm-dot.ashray.xyz/docs/:path*", "permanent": false },
    { "source": "/reference", "destination": "https://dm-dot.ashray.xyz/docs", "permanent": true },
    { "source": "/reference/:path*", "destination": "https://dm-dot.ashray.xyz/docs/:path*", "permanent": true }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
